<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>WarpCode.Smidgen</RootNamespace>

    <!-- NuGet Package Metadata -->
    <PackageId>WarpCode.Smidgen</PackageId>
    <Product>Smidgen</Product>
    <Description>High-performance .NET library for generating 60-bit, time-ordered, monotonic identifiers with cryptographic entropy, with no coordination required. IDs from one generator never repeat; IDs from separate generators can collide, increasingly so under load.</Description>
    <Copyright>Copyright (c) $([System.DateTime]::Now.Year) Pete Warner</Copyright>
    <PackageProjectUrl>https://github.com/pwarner/WarpCode.Smidgen</PackageProjectUrl>
    <RepositoryUrl>https://github.com/pwarner/WarpCode.Smidgen</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>readme.md</PackageReadmeFile>
    <PackageTags>id-generator;snowflake;monotonic;time-ordered;identifier;ulid;guid-alternative;database;high-performance</PackageTags>
    <!-- publish a .snupkg to the NuGet symbol server alongside the package -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- The package version and release notes are set by the release workflow from the GitHub Release (-p:Version=...). -->
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\readme.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
