<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>WarpCode.Smidgen</RootNamespace>

    <!-- NuGet Package Metadata -->
    <PackageId>WarpCode.Smidgen</PackageId>
    <Version>1.0.1</Version>
    <Authors>Pete Warner</Authors>
    <Company>WarpCode</Company>
    <Product>Smidgen</Product>
    <Description>High-performance .NET library for generating 60-bit monotonic identifiers with time-ordering and cryptographic entropy. Ideal for databases and distributed systems requiring coordination-free ID generation.</Description>
    <Copyright>Copyright (c) $([System.DateTime]::Now.Year) Pete Warner</Copyright>
    <PackageProjectUrl>https://github.com/pwarner/WarpCode.Smidgen</PackageProjectUrl>
    <RepositoryUrl>https://github.com/pwarner/WarpCode.Smidgen</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>id-generator;snowflake;monotonic;time-ordered;identifier;ulid;guid-alternative;database;high-performance</PackageTags>
    <PackageReleaseNotes>Initial release of Smidgen ID generator library.</PackageReleaseNotes>

    <!-- Build Options -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
